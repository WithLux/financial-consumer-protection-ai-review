# Server-only; never place API keys in browser JavaScript
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_ENABLED=false
# Proposed runtime settings; application support is pending implementation
DATABASE_PATH=runtime/reviews.sqlite3
UPLOAD_DIR=runtime/uploads
EXPORT_DIR=runtime/exports
MAX_UPLOAD_MB=10
LLM_TIMEOUT_SECONDS=60
DEMO_ACCESS_TOKEN=

# Planned controls; not yet wired to runtime
DATA_DIR=runtime
DEMO_DAILY_TOKEN_BUDGET=100000
